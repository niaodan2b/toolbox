{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbox",
  "version": "0.2.2",
  "identifier": "com.niaodan.toolbox",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toolbox",
        "width": 1300,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**"
          ]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QjFDREJGNTAxRjc3RTIKUldUaWR4OVF2ODJ4V0tIS1dGOWRWT0hZTlVockZ3V3haVFpEQW9UcU9yalZzNTN2OTBnS3R1RFYK",
      "endpoints": [
        "https://github.com/niaodan2b/toolbox/releases/latest/download/latest.json"
      ]
    }
  }
}